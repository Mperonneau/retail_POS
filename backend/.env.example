# Copy to .env for local work. Never commit real values.

# --- Django ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
# Keys the 4-digit staff PINs (HMAC). Set once and never change it,
# or every PIN must be reset.
PIN_PEPPER=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=0
# Empty to turn the admin off.
DJANGO_ADMIN_URL=admin/
LOG_LEVEL=INFO

# --- Database and cache ---
# SQLite when empty. Production: postgres://user:pass@host:5432/db
DATABASE_URL=
DB_CONN_MAX_AGE=60
REDIS_URL=
MEDIA_ROOT=

# --- Production security ---
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# --- Business defaults ---
DAY_USD_RATE=135
STAFF_SESSION_HOURS=12
OWNER_SESSION_DAYS=30
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=5
THROTTLE_ANON=120/min
THROTTLE_USER=1200/min

# --- Firebase (owner sign-in) ---
# Service-account JSON, inline or a file path. Empty until Firebase exists.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
# DEBUG/tests only: accept "dev:<uid>[:email][:phone]" bearer tokens.
FIREBASE_DEV_MODE=1

# --- Vitrine shoppers ---
SHOPPER_SESSION_DAYS=90
# console | twilio | firebase
PHONE_VERIFICATION_BACKEND=console
# DEBUG/tests only: any SMS code is accepted.
STOREFRONT_ACCEPT_ANY_CODE=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
STOREFRONT_RESERVATION_MINUTES=60
STOREFRONT_URL=https://retail-pos-storefront.onrender.com
STOREFRONT_LEGACY_PUBLISH=1

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MONCASH_CLIENT_ID=
MONCASH_SECRET=
MONCASH_BASE_URL=https://moncashbutton.digicelgroup.com
PUBLIC_BASE_URL=
LEGACY_PAYMENTS_OPEN=1

# --- AI catalog import ---
CLAUDE_API_SECRET_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
